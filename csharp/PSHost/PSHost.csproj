<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PSHost</RootNamespace>
    <AssemblyName>pshost</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Publish settings: applied via `dotnet publish -r <rid>` with self-contained.

    We ship a single self-contained executable per platform so the provider has
    no external dependencies (no system PowerShell, no .NET runtime required) and
    works on any OS/arch Terraform supports.

    IMPORTANT: the PowerShell SDK is NOT compatible with PublishSingleFile on its
    own, nor with PublishTrimmed. It resolves $PSHOME from the assembly location,
    which is empty inside a normal single-file bundle, so InitialSessionState
    throws (PSSnapInReader -> Path.Combine(null)). IncludeAllContentForSelfExtract
    extracts the bundle to a temp directory at launch so $PSHOME resolves, which
    is what makes single-file work on Windows as well as Linux/macOS. Trimming is
    left off because the SDK loads cmdlet assemblies dynamically.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.*" />
  </ItemGroup>

</Project>
